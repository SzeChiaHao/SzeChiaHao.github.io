---
import type { CollectionEntry } from 'astro:content';
import { AUTHOR } from '../consts';
import { readingTime } from '../utils/readingTime';
import Comment from '../components/Comment.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, date, tags, author } = post.data;
const authorName = author ?? AUTHOR;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const fmt = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const rt = readingTime(post.body);
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{title}</h1>
    {description && <p class="post-desc">{description}</p>}
    <div class="post-meta">
      <span>{authorName}</span>
      <span class="dot">·</span>
      <time datetime={date.toISOString()}>{fmt}</time>
      <span class="dot">·</span>
      <span>{rt}</span>
    </div>
    {tags && tags.length > 0 && (
      <div class="post-tags">
        {tags.map((t) => (
          <a class="tag" href={`/tags/${t}/`}>#{t}</a>
        ))}
      </div>
    )}
  </header>

  {
    toc.length > 0 && (
      <nav class="toc" aria-label="文章目录">
        <div class="toc-title">目录</div>
        <ul>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="prose">
    <slot />
  </div>

  <Comment />

  <footer class="post-footer">
    <a href="/">← 返回首页</a>
  </footer>
</article>
