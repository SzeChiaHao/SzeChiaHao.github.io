---
import type { CollectionEntry } from 'astro:content';
import { AUTHOR } from '../consts';
import { readingTime } from '../utils/readingTime';
import Comment from '../components/Comment.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, date, tags, author } = post.data;
const authorName = author ?? AUTHOR;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const fmt = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const rt = readingTime(post.body);
---

<div class="post-layout">
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        <span>{authorName}</span>
        <span class="dot">·</span>
        <time datetime={date.toISOString()}>{fmt}</time>
        <span class="dot">·</span>
        <span>{rt}</span>
      </div>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((t) => (
            <a class="tag" href={`/tags/${t}/`}>#{t}</a>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <Comment />

    <footer class="post-footer">
      <a href="/">← 返回首页</a>
    </footer>
  </article>

  {
    toc.length > 0 && (
      <>
        <button class="toc-toggle" id="tocToggle" type="button" aria-label="打开目录">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
        </button>
        <div class="toc-backdrop" id="tocBackdrop"></div>
        <aside class="toc-sidebar" id="tocSidebar">
          <div class="toc-title">
            <span>目录</span>
            <button class="toc-close" id="tocClose" type="button" aria-label="关闭目录">×</button>
          </div>
          <nav class="toc-nav" aria-label="文章目录">
            <ul>
              {toc.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      </>
    )
  }
</div>

<script>
  // 右侧目录滚动高亮（scroll-spy）：随阅读位置高亮当前小节
  (function () {
    const links = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
    if (links.length === 0) return;
    const headings = links
      .map((a) => document.getElementById(a.getAttribute('href').slice(1)))
      .filter(Boolean);
    if (headings.length === 0) return;

    // 各小节距文档顶部的绝对偏移，只在尺寸变化时重算
    let offsets = [];
    function cache() {
      offsets = headings.map((h) => h.getBoundingClientRect().top + window.scrollY);
    }
    cache();
    window.addEventListener('resize', cache);
    window.addEventListener('load', cache);

    let ticking = false;
    function update() {
      const pos = window.scrollY + 120; // 判定阈值
      let current = -1;
      offsets.forEach((o, i) => {
        if (o <= pos) current = i;
      });
      links.forEach((a, i) => a.classList.toggle('active', i === current));
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    });
    update();
  })();
</script>

<script>
  // 移动端目录抽屉：开关、点击遮罩/链接/关闭按钮时收起
  (function () {
    var toggle = document.getElementById('tocToggle');
    var sidebar = document.getElementById('tocSidebar');
    var backdrop = document.getElementById('tocBackdrop');
    var close = document.getElementById('tocClose');
    if (!toggle || !sidebar) return;
    function openToc() {
      sidebar.classList.add('open');
      if (backdrop) backdrop.classList.add('open');
      toggle.classList.add('hidden');
    }
    function closeToc() {
      sidebar.classList.remove('open');
      if (backdrop) backdrop.classList.remove('open');
      toggle.classList.remove('hidden');
    }
    toggle.addEventListener('click', openToc);
    if (close) close.addEventListener('click', closeToc);
    if (backdrop) backdrop.addEventListener('click', closeToc);
    sidebar.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeToc);
    });
  })();
</script>
