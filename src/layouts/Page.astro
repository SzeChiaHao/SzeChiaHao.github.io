---
import Base from './Base.astro';

interface Props {
  frontmatter: {
    title: string;
  };
}

const { frontmatter } = Astro.props;
const { title } = frontmatter;
---

<Base title={title}>
  <article class="post">
    <h1 class="post-title">{title}</h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
