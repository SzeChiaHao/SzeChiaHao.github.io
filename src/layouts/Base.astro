---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, CATEGORIES } from '../consts';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const pageDesc = description ?? SITE_DESCRIPTION;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <script is:inline>
      // 首帧前确定主题与磨砂玻璃参数，避免闪烁
      (function () {
        function read(key, def) {
          try {
            var v = localStorage.getItem(key);
            return v === null ? def : v;
          } catch (e) {
            return def;
          }
        }
        var pref = read('theme', 'auto');
        var sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = pref === 'light' || pref === 'dark' ? pref : sysDark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;

        var opacity = parseInt(read('glassOpacity', '32'), 10);
        var blur = parseInt(read('glassBlur', '9'), 10);
        var style = document.documentElement.style;
        style.setProperty('--glass-opacity', String(opacity / 100));
        style.setProperty('--glass-blur', blur + 'px');
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="header-left">
          <button class="icon-btn" id="settingsBtn" type="button" aria-label="设置" title="设置">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            </svg>
          </button>
          <a class="site-logo" href="/">{SITE_TITLE}</a>
        </div>
        <nav class="site-nav">
          <a href="/">首页</a>
          {CATEGORIES.map((c) => (
            <a href={`/tags/${c}/`}>{c}</a>
          ))}
          <a href="/about/">关于</a>
        </nav>
        <div class="header-search">
          <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" id="searchInput" placeholder="搜索文章…" autocomplete="off" spellcheck="false" aria-label="搜索文章" />
        </div>
      </div>
    </header>

    <div class="settings-panel" id="settingsPanel" role="dialog" aria-label="页面设置">
      <div class="settings-panel-title">设置</div>

      <div class="setting-group">
        <div class="setting-label">主题</div>
        <div class="theme-options">
          <button type="button" data-theme-choice="light">浅色</button>
          <button type="button" data-theme-choice="dark">深色</button>
          <button type="button" data-theme-choice="auto">自动</button>
        </div>
      </div>

      <div class="setting-group">
        <div class="setting-label">
          磨砂玻璃不透明度
          <span class="setting-val" id="opacityVal">32%</span>
        </div>
        <input type="range" id="glassOpacity" min="0" max="100" step="1" value="32" />
      </div>

      <div class="setting-group">
        <div class="setting-label">
          磨砂玻璃模糊度
          <span class="setting-val" id="blurVal">9px</span>
        </div>
        <input type="range" id="glassBlur" min="0" max="30" step="1" value="9" />
      </div>
    </div>

    <main class={wide ? 'container-wide' : 'container'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {AUTHOR}</span>
        <a href="/rss.xml">RSS 订阅</a>
      </div>
    </footer>

    <script>
      (function () {
        function read(key, def) {
          try {
            var v = localStorage.getItem(key);
            return v === null ? def : v;
          } catch (e) {
            return def;
          }
        }
        function write(key, val) {
          try {
            localStorage.setItem(key, val);
          } catch (e) {}
        }
        var root = document.documentElement;

        // ===== 主题（浅色 / 深色 / 自动）=====
        function sysDark() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
        function applyTheme(pref) {
          var theme = pref === 'light' || pref === 'dark' ? pref : sysDark() ? 'dark' : 'light';
          root.dataset.theme = theme;
          window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } }));
          document.querySelectorAll('[data-theme-choice]').forEach(function (b) {
            b.classList.toggle('active', b.getAttribute('data-theme-choice') === pref);
          });
        }
        document.querySelectorAll('[data-theme-choice]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var pref = btn.getAttribute('data-theme-choice');
            write('theme', pref);
            applyTheme(pref);
          });
        });
        // 自动模式下跟随系统主题变化
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (read('theme', 'auto') === 'auto') applyTheme('auto');
        });
        applyTheme(read('theme', 'auto'));

        // ===== 磨砂玻璃参数 =====
        var opacitySlider = document.getElementById('glassOpacity');
        var blurSlider = document.getElementById('glassBlur');
        var opacityVal = document.getElementById('opacityVal');
        var blurVal = document.getElementById('blurVal');
        function applyGlass() {
          root.style.setProperty('--glass-opacity', String(parseInt(opacitySlider.value, 10) / 100));
          root.style.setProperty('--glass-blur', parseInt(blurSlider.value, 10) + 'px');
          opacityVal.textContent = opacitySlider.value + '%';
          blurVal.textContent = blurSlider.value + 'px';
        }
        opacitySlider.value = read('glassOpacity', '32');
        blurSlider.value = read('glassBlur', '9');
        opacitySlider.addEventListener('input', function () {
          write('glassOpacity', opacitySlider.value);
          applyGlass();
        });
        blurSlider.addEventListener('input', function () {
          write('glassBlur', blurSlider.value);
          applyGlass();
        });
        applyGlass();

        // ===== 设置面板开关 =====
        var settingsBtn = document.getElementById('settingsBtn');
        var panel = document.getElementById('settingsPanel');
        settingsBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          panel.classList.toggle('open');
        });
        document.addEventListener('click', function (e) {
          if (panel.classList.contains('open') && !panel.contains(e.target) && e.target !== settingsBtn) {
            panel.classList.remove('open');
          }
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') panel.classList.remove('open');
        });

        // ===== 搜索框：按 / 快速聚焦（搜索功能后续接入）=====
        var searchInput = document.getElementById('searchInput');
        document.addEventListener('keydown', function (e) {
          if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
          var tag = document.activeElement && document.activeElement.tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA') return;
          e.preventDefault();
          searchInput.focus();
        });
      })();
    </script>
  </body>
</html>
